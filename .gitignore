# macOS
.DS_Store
._*

# Local Claude Code permissions — machine-specific, not project config
.claude/settings.local.json

# Editor / OS noise
*.swp
*~
Thumbs.db

# Nothing here is built, but just in case tooling ever lands
node_modules/
*.log

# Backfill credentials — service_role key and R2 secret. Never commit.
tools/backfill-config.txt
__pycache__/

# ---- Native shell (Capacitor) ----
# node_modules is the toolchain; www/ is generated by scripts/build-www.js
# and is a copy of files already tracked at the repo root. ios/ IS tracked
# deliberately -- it holds Info.plist, the signing config and the app icons,
# which are real source, and regenerating it would lose them.
node_modules/
www/
ios/App/App/public/
ios/App/build/
ios/DerivedData/

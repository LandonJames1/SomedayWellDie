<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PRIVACY MANIFEST — the App target's own.

  ⚠️ BEING IN THIS FOLDER IS NOT WHAT PUTS IT IN THE BINARY. It is
  registered in the App target's Copy Bundle Resources phase (a
  PBXFileReference, a PBXBuildFile, an entry in the App group and one
  in PBXResourcesBuildPhase, all in App.xcodeproj/project.pbxproj), and
  without that it would simply be a file on disk — with the first sign
  of trouble being ITMS-91053 on upload, long after it was written.

  Verify after any project change:

      xcodebuild -project ios/App/App.xcodeproj -scheme App \
        -sdk iphonesimulator -derivedDataPath /tmp/dd \
        CODE_SIGNING_ALLOWED=NO build
      ls /tmp/dd/Build/Products/Debug-iphonesimulator/App.app/PrivacyInfo.xcprivacy

  Capacitor ships manifests for its own frameworks
  (node_modules/@capacitor/ios/.../PrivacyInfo.xcprivacy) and they cover
  Capacitor, not this app. Everything below is what THIS app collects,
  and every entry has to agree with three other things:

    - legal/privacy.html, section 2
    - the App Store Connect privacy questionnaire
    - what the code actually does

  ⚠️ NSPrivacyCollectedDataTypeLinked IS TRUE FOR EVERYTHING HERE. All
  of it hangs off an account. "Linked" is not about whether you sell it
  — it is about whether it is tied to an identity, and here it always
  is.

  ⚠️ TRACKING IS FALSE AND MUST STAY FALSE unless an analytics or
  advertising SDK is ever added. Declaring false while shipping a
  tracker is a misrepresentation to Apple, not a checkbox.
-->
<plist version="1.0">
<dict>
  <!-- Required-reason APIs. Only what the app actually calls. -->
  <key>NSPrivacyAccessedAPITypes</key>
  <array>
    <dict>
      <!-- UserDefaults, reached through the App Group shared with the
           widget and the share extension (WidgetBridge.swift,
           ShareInbox.swift). CA92.1 is the reason code for access
           limited to the app and its own app-group containers. -->
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array><string>CA92.1</string></array>
    </dict>
    <dict>
      <!-- File timestamps, via WKWebView's own storage and the tmp
           files NativeMedia.swift writes for a picked photo. C617.1 =
           inside the app's own container. -->
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array><string>C617.1</string></array>
    </dict>
    <dict>
      <!-- Disk space, checked by the system frameworks underneath the
           web view before writing. E174.1 = to avoid a write failure. -->
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryDiskSpace</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array><string>E174.1</string></array>
    </dict>
    <dict>
      <!-- System boot time, used by the frameworks for elapsed-time
           measurement. 35F9.1 = to measure time within the app. -->
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategorySystemBootTime</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array><string>35F9.1</string></array>
    </dict>
  </array>

  <key>NSPrivacyCollectedDataTypes</key>
  <array>
    <!-- The sign-in address. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeEmailAddress</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>

    <!-- Display name and username, shown to other people in a shared
         list. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeName</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>

    <!-- The date of birth from the age screen, and the "About you"
         paragraph. Apple files both under Other User Content /
         Sensitive Info; date of birth is "Other Data Types". -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeOtherDataTypes</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>

    <!-- ⚠️ PRECISE, NOT COARSE. An activity stores the exact
         latitude/longitude of the place it happens, and a photo's EXIF
         fix is read to offer one. Declaring coarse here would be
         wrong. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypePreciseLocation</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>

    <!-- Completion photos and video, and the profile photo. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypePhotosorVideos</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>

    <!-- Messages in a shared list's conversation. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeCustomerSupport</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>

    <!-- The lists, activities and notes themselves — the app's whole
         point. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeOtherUserContent</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>

    <!-- User ID — the account's uuid, which every row is keyed by. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeUserID</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>
  </array>

  <!-- No analytics, no ad SDK, no third-party trackers. Nothing here
       reaches a tracking domain, which is why the array is empty
       rather than absent. -->
  <key>NSPrivacyTrackingDomains</key>
  <array/>
  <key>NSPrivacyTracking</key>
  <false/>
</dict>
</plist>

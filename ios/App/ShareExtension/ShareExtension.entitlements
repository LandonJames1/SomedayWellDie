<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The stash the extension writes and the app reads. Same string
	     as App.entitlements and SomedayWidget.entitlements. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.landonjames.somedaywelldie</string>
	</array>
</dict>
</plist>
